/**
 * data.ts — Wrapper روی db.json
 * 
 * این فایل داده‌ها رو از `src/data/db.json` می‌خونه
 * و به همه‌جا export می‌کنه.
 * 
 * تمام صفحات و کامپوننت‌ها بدون تغییر کار می‌کنن.
 */

import type {
  Course,
  Instructor,
  Testimonial,
  BlogPost,
  Branch,
} from '@/types';

import db from '@/data/db.json';

/* ============================================================
   🔧 تایپ‌های داخلی (برای db.json)
   ============================================================ */
interface CourseRaw {
  id: string;
  slug: string;
  title: string;
  description: string;
  shortDescription?: string;
  mode: 'online' | 'in-person' | 'hybrid';
  level: string;
  duration: number;
  sessions: number;
  price: {
    'in-person'?: number;
    online?: number;
    hybrid?: number;
  };
  image: string;
  instructorId: string;
  rating: number;
  studentsCount: number;
  capacity: number;
  remainingCapacity: number;
  startDate: string;
  schedule: string;
  prerequisites: string[];
  certificate: boolean;
  tags: string[];
  isActive: boolean;
  createdAt: string;
  updatedAt: string;
}

/* ============================================================
   🔧 توابع کمکی داخلی
   ============================================================ */

/**
 * یه دوره رو با اطلاعات کامل استادش برمی‌گردونه
 * (چون db.json فقط instructorId داره)
 */
function hydrateCourse(course: CourseRaw): Course {
  const instructor = db.instructors.find(
    (i: any) => i.id === course.instructorId
  );

  // حذف instructorId از خروجی نهایی
  const { instructorId, ...rest } = course;

  return {
    ...rest,
    instructor: instructor as Instructor,
  } as unknown as Course;
}

/**
 * حذف دوره‌ها/محصولات/... غیرفعال
 */
function onlyActive<T extends { isActive?: boolean }>(items: T[]): T[] {
  return items.filter((item) => item.isActive !== false);
}

/* ============================================================
   📦 داده‌ها (با hydration)
   ============================================================ */

// 👨‍🏫 اساتید
export const instructors: Instructor[] = onlyActive(
  db.instructors as any[]
) as Instructor[];

// 🎓 دوره‌ها (با hydrate)
export const courses: Course[] = onlyActive(db.courses as any[])
  .map((c: any) => hydrateCourse(c as CourseRaw));

// 💬 نظرات
export const testimonials: Testimonial[] = onlyActive(
  db.testimonials as any[]
) as Testimonial[];

// 📰 مقالات
export const blogPosts: BlogPost[] = onlyActive(
  db.blogPosts as any[]
) as BlogPost[];

// 🏢 شعبه‌ها
export const branches: Branch[] = onlyActive(
  db.branches as any[]
) as Branch[];

// 📊 آمار
export const stats = db.stats;

// 🎯 دسته‌بندی مهارت‌ها
export const skillCategories = db.skillCategories;

// 📝 آزمون‌ها
export const exams = onlyActive(db.exams as any[]);

// 🛍️ محصولات
export const products = onlyActive(db.products as any[]);

// 🎥 کلاس‌های زنده
export const liveClasses = onlyActive(db.liveClasses as any[]);

// ⚙️ تنظیمات سایت (جدید)
export const settings = db.settings;

/* ============================================================
   🎯 توابع کمکی (بدون تغییر نسبت به قبل)
   ============================================================ */

export function getPopularCourses(limit = 6): Course[] {
  return [...courses]
    .sort((a, b) => b.studentsCount - a.studentsCount)
    .slice(0, limit);
}

export function getCoursesByMode(
  mode: 'online' | 'in-person' | 'hybrid'
): Course[] {
  return courses.filter((c) => c.mode === mode);
}

export function getCourseBySlug(slug: string): Course | undefined {
  return courses.find((c) => c.slug === slug);
}

export function getCoursesByInstructor(instructorId: string): Course[] {
  return courses.filter((c) => c.instructor.id === instructorId);
}

export function getRelatedCourses(course: Course, limit = 3): Course[] {
  return courses
    .filter((c) => c.id !== course.id && c.mode === course.mode)
    .slice(0, limit);
}

export function getCoursesByCategory(tag: string): Course[] {
  return courses.filter((c) => c.tags.includes(tag));
}

export function getLatestPosts(limit = 3): BlogPost[] {
  return blogPosts.slice(0, limit);
}

export function getExamBySlug(slug: string): any {
  return exams.find((e: any) => e.slug === slug);
}

export function getRelatedExams(exam: any, limit = 3): any[] {
  return exams
    .filter((e: any) => e.id !== exam.id && e.type === exam.type)
    .slice(0, limit);
}

export function getProductBySlug(slug: string): any {
  return products.find((p: any) => p.slug === slug);
}

export function getRelatedProducts(product: any, limit = 3): any[] {
  return products
    .filter((p: any) => p.id !== product.id && p.type === product.type)
    .slice(0, limit);
}

export function getLiveClassBySlug(slug: string): any {
  return liveClasses.find((l: any) => l.slug === slug);
}

export function getRelatedLiveClasses(liveClass: any, limit = 3): any[] {
  return liveClasses
    .filter((l: any) => l.id !== liveClass.id)
    .slice(0, limit);
}